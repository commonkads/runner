{
  "name": "@commonkads/runner",
  "version": "0.1.0",
  "description": "Knowledge authoring and test-runner tools for CommonKADS domains",
  "type": "module",
  "author": "Rob Proper",
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "runner": "./dist/cli/index.js"
  },
  "scripts": {
    "precompile": "npm run lint:fix",
    "compile": "tsc --build && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier \"./**/*.ts\" --write",
    "lint:fix": "npm run lint -- --fix",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "postlint": "npm run format",
    "prerepackage": "rm -rf dist",
    "repackage": "npm audit --audit-level=high && npm run compile && npm run test:ci && npm run package",
    "package": "npm pack --pack-destination dist/",
    "test": "node --no-warnings --import tsx/esm --test $(find src -name '*.test.ts' | sort)",
    "test:ci": "node --no-warnings --import tsx/esm --test-reporter spec --test-reporter-destination stdout --test-reporter junit --test-reporter-destination test-results.xml --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@commonkads/engine": "*",
    "commander": "^14.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
