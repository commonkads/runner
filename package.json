{
  "name": "@commonkads/runner",
  "version": "0.1.0",
  "private": true,
  "description": "CLI runner for the CommonKADS engine",
  "type": "module",
  "author": "Rob Proper",
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "bin": {
    "runner": "./dist/cli/index.js"
  },
  "scripts": {
    "precompile": "npm run lint:fix",
    "compile": "tsc --build && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier \"./**/*.ts\" --write",
    "lint:fix": "npm run lint -- --fix",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "postlint": "npm run format",
    "start": "node --no-warnings --import tsx/esm src/cli/index.ts",
    "test:integration": "node --no-warnings --import tsx/esm --test $(find test -name '*.test.integration.ts' | sort)"
  },
  "dependencies": {
    "@commonkads/engine": "*",
    "@commonkads/provider-anthropic": "*",
    "@commonkads/provider-aws": "*",
    "@commonkads/provider-google": "*",
    "@commonkads/provider-ollama": "*",
    "@commonkads/provider-openai": "*",
    "commander": "^14.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commonkads/dev-workflow": "1.1.0",
    "@commonkads/knowledge-examples": "*",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "allowScripts": {
    "@commonkads/dev-workflow": true
  }
}
